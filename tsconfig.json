{
    "extends": "@vue/tsconfig/tsconfig.dom.json",
    "compilerOptions": {
        "lib": ["ES2023", "DOM", "DOM.Iterable"],
        "types": ["vite/client", "node"],
        "paths": {
            "@/*": ["./resources/js/*"]
        },
        "noUncheckedIndexedAccess": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true
    },
    "include": ["resources/js/**/*.ts", "resources/js/**/*.vue", "*.config.ts"]
}
